{
  "name": "saafsaathi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "emulators": "firebase emulators:start --project demo-saafsaathi",
    "seed": "node scripts/seed.mjs",
    "models": "node scripts/make-placeholder-models.mjs",
    "deploy": "npm run build && firebase deploy",
    "emulators:persist": "firebase emulators:start --project demo-saafsaathi $([ -d emulator-data ] && echo --import=./emulator-data) --export-on-exit=./emulator-data",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules-test 'node --test tests/rules.test.mjs'",
    "local": "firebase emulators:exec --ui --project demo-saafsaathi $([ -d emulator-data ] && echo --import=./emulator-data) --export-on-exit=./emulator-data \"vite --port 5173\"",
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "seed:live": "node scripts/seed.mjs --live",
    "seed:clear-live": "node scripts/seed-clear-live.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0",
    "i18next": "^26.4.2",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.49.0",
    "ngeohash": "^0.6.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
